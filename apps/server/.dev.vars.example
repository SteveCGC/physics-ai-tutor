# 本地开发密钥模板 — 复制为 .dev.vars 并填入真实值
# .dev.vars 已加入 .gitignore，不会被提交

# Supabase
# Project URL 和 Anon Key：Supabase 控制台 → Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
# 数据库直连地址（Session 模式，端口 5432）：Supabase 控制台 → Connect → Session
SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# 智谱 AI（GLM）
# 申请地址: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key

# 阿里云百炼（Qwen / Embedding）
# 申请地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key

# Cloudflare R2（本地开发用 S3 兼容模式）
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
