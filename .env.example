# ============================================================
# physics-ai-tutor 环境变量示例
# 复制为 .env 并填写真实值（不要提交 .env 到 git）
# ============================================================

# 智谱 AI（GLM-4-Flash 免费，用于 AI 出题 & 质检）
ZHIPU_API_KEY=

# 阿里百炼（text-embedding-v3，P1 阶段激活，MVP 不需要）
DASHSCOPE_API_KEY=

# Supabase 项目配置
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL 直连（含 pgvector，P1 启用后需要）
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# 前端地址（本地开发）
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 文件存储
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ACCOUNT_ID=your-cloudflare-account-id
